# =====================================================================
# AI Document Intelligence Assistant - Environment Configuration
# Copy this file to .env and configure your API keys and settings.
# =====================================================================

# --- LLM Provider ---
# Select one: gemini, openai, groq
LLM_PROVIDER=gemini

# Provide the API key for your chosen provider
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Database ---
# Default is SQLite for easy local setup.
DATABASE_URL=sqlite+aiosqlite:///./doc_intelligence.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# --- Authentication ---
JWT_SECRET_KEY=generate_a_secure_random_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# --- File Management ---
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=data/uploads
VECTOR_STORE_DIR=vector_store
